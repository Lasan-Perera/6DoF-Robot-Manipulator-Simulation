<?xml version="1.0"?>
<sdf version="1.9">
  <world name="pick_place_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Box A: 30x30x20 cm, at (1, 1, 0) per task sheet. Static — it's a target platform. -->
    <model name="box_a">
      <static>true</static>
      <pose>0.5 0.5 0.10 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.30 0.30 0.20</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.30 0.30 0.20</size></box></geometry>
          <material><ambient>0.7 0.4 0.1 1</ambient><diffuse>0.7 0.4 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Box B: 5x5x5 cm. Free rigid body — must be graspable and stay upright. -->
    <model name="box_b">
      <pose>-0.28 -0.55 0.025 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.0000417</ixx><iyy>0.0000417</iyy><izz>0.0000417</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <!-- cube friction. bullet-featherstone reads the <bullet> value (default 1.0); <ode> is for other engines -->
          <surface>
            <friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode><bullet><friction>1.5</friction><friction2>1.5</friction2></bullet></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material><ambient>0.1 0.5 0.8 1</ambient><diffuse>0.1 0.5 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
<model name="overhead_camera">
      <static>true</static>
      <pose>0.85 0.85 1.5 0 0 0</pose>
      <link name="link">
        <visual name="mount_pole">
          <pose>0 0 -0.75 0 0 0</pose>
          <geometry><cylinder><radius>0.02</radius><length>1.5</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <visual name="camera_body">
          <geometry><box><size>0.06 0.10 0.06</size></box></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
        <sensor name="camera" type="camera">
          <pose>0 0 0 0 1.5708 0</pose>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>1280</width>
              <height>960</height>
            </image>
            <clip>
              <near>0.1</near>
              <far>10</far>
            </clip>
          </camera>
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <visualize>true</visualize>
          <topic>camera/image_raw</topic>
        </sensor>
      </link>
    </model>
</world>
</sdf>
