<?xml version="1.0"?>
<sdf version="1.9">
  <world name="pick_place_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Box A: 30x30x20 cm, at (1, 1, 0) per task sheet. Static — it's a target platform. -->
<model name="overhead_camera">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <visual name="mount_pole">
          <pose>0.9 0.02 0.9 0 0 0</pose>
          <geometry><cylinder><radius>0.02</radius><length>1.8</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <visual name="mount_boom">
          <pose>0.71 0.02 1.8 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.015</radius><length>0.38</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <visual name="camera_body">
          <pose>0.52 0.02 1.8 0 0 0</pose>
          <geometry><box><size>0.06 0.10 0.06</size></box></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
        <sensor name="camera" type="camera">
          <pose>0.52 0.02 1.8 0 1.5708 0</pose>
          <pose>0 0 0 0 1.5708 0</pose>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>1280</width>
              <height>960</height>
            </image>
            <clip>
              <near>0.1</near>
              <far>10</far>
            </clip>
          </camera>
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <visualize>true</visualize>
          <topic>camera/image_raw</topic>
        </sensor>
      </link>
    </model>
<model name="box_red">
      <pose>0.5 -0.15 0.025 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.1</mass>
          <inertia><ixx>4.17e-5</ixx><iyy>4.17e-5</iyy><izz>4.17e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box_green">
      <pose>0.65 0.05 0.025 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.1</mass>
          <inertia><ixx>4.17e-5</ixx><iyy>4.17e-5</iyy><izz>4.17e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material><ambient>0.1 0.7 0.1 1</ambient><diffuse>0.1 0.7 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box_blue">
      <pose>0.4 0.15 0.025 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.1</mass>
          <inertia><ixx>4.17e-5</ixx><iyy>4.17e-5</iyy><izz>4.17e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material><ambient>0.1 0.1 0.8 1</ambient><diffuse>0.1 0.1 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
<model name="platform_red">
      <static>true</static>
      <pose>0.55 -0.35 0.025 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 0.15 0.05</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.15 0.15 0.05</size></box></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="platform_green">
      <static>true</static>
      <pose>0.65 0.3 0.025 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 0.15 0.05</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.15 0.15 0.05</size></box></geometry>
          <material><ambient>0.1 0.7 0.1 1</ambient><diffuse>0.1 0.7 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="platform_blue">
      <static>true</static>
      <pose>0.3 0.4 0.025 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 0.15 0.05</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.15 0.15 0.05</size></box></geometry>
          <material><ambient>0.1 0.1 0.8 1</ambient><diffuse>0.1 0.1 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
</world>
</sdf>
