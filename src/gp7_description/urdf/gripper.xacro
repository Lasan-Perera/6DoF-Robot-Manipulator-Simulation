<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="simple_gripper" params="prefix parent">

    <material name="gripper_grey">
      <color rgba="0.3 0.3 0.3 1.0"/>
    </material>

    <joint name="${prefix}gripper_base_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}gripper_base"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}gripper_base">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.3"/>
        <inertia ixx="0.0001125" iyy="0.000045" izz="0.0001125" ixy="0" ixz="0" iyz="0"/>
      </inertial>
      <visual>
        <geometry><box size="0.03 0.06 0.03"/></geometry>
        <material name="gripper_grey"/>
      </visual>
      <collision>
        <geometry><box size="0.03 0.06 0.03"/></geometry>
      </collision>
    </link>

    <joint name="${prefix}finger_left_joint" type="prismatic">
      <parent link="${prefix}gripper_base"/>
      <child link="${prefix}finger_left"/>
      <origin xyz="0.03 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="0.0" upper="0.025" effort="20" velocity="0.05"/>
    </joint>

    <link name="${prefix}finger_left">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.05"/>
        <inertia ixx="0.0000008" iyy="0.0000071" izz="0.0000071" ixy="0" ixz="0" iyz="0"/>
      </inertial>
      <visual>
        <geometry><box size="0.04 0.01 0.01"/></geometry>
        <material name="gripper_grey"/>
      </visual>
      <collision>
        <geometry><box size="0.04 0.01 0.01"/></geometry>
      </collision>
    </link>

    <joint name="${prefix}finger_right_joint" type="prismatic">
      <parent link="${prefix}gripper_base"/>
      <child link="${prefix}finger_right"/>
      <origin xyz="0.03 0 0" rpy="0 0 0"/>
      <axis xyz="0 -1 0"/>
      <limit lower="0.0" upper="0.025" effort="20" velocity="0.05"/>
    </joint>

    <link name="${prefix}finger_right">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.05"/>
        <inertia ixx="0.0000008" iyy="0.0000071" izz="0.0000071" ixy="0" ixz="0" iyz="0"/>
      </inertial>
      <visual>
        <geometry><box size="0.04 0.01 0.01"/></geometry>
        <material name="gripper_grey"/>
      </visual>
      <collision>
        <geometry><box size="0.04 0.01 0.01"/></geometry>
      </collision>
    </link>

    <joint name="${prefix}tcp_joint" type="fixed">
      <parent link="${prefix}gripper_base"/>
      <child link="${prefix}tcp"/>
      <origin xyz="0.07 0 0" rpy="0 0 0"/>
    </joint>
    <link name="${prefix}tcp"/>

  </xacro:macro>
</robot>
